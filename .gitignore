# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.tox/
.nox/
coverage.xml
.coverage
.coverage.*
htmlcov/

# Virtual environments and local Python packaging metadata
.venv/
venv/
env/
ENV/
.env/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.egg

# Node.js caches and dependency directories
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PyInstaller and other local build outputs
build/
dist/

# Browser automation profile: contains login sessions, cookies, cache, and
# other machine-specific Chrome data.
ChromeRecorderProfile/

# Local runtime logs and temporary files
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig

# Test/report output generated by browser or Python test tools
test-results/
playwright-report/
blob-report/

# IDE and operating-system metadata
.idea/
.vscode/
.vs/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Local secrets. Keep shareable templates explicitly.
.env
.env.*
!.env.example
